<?xml version="1.0" encoding="utf-8"?>
<!-- Paginka quick actions: Scan (yellow, the main one), Edit PDF, Sign, To PDF -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/pe_widget_bg"
  android:gravity="center"
  android:orientation="horizontal"
  android:padding="8dp">
  <LinearLayout
    android:id="@+id/pe_w_scan"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/pe_widget_btn_main"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:contentDescription="Scan"
      android:src="@drawable/pe_ic_scan" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Scan"
      android:textColor="#1E2559"
      android:textSize="12sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/pe_w_open"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/pe_widget_btn"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:contentDescription="Edit PDF"
      android:src="@drawable/pe_ic_open_w" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Edit PDF"
      android:textColor="#FFFFFF"
      android:textSize="12sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/pe_w_sign"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/pe_widget_btn"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:contentDescription="Sign"
      android:src="@drawable/pe_ic_sign_w" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Sign"
      android:textColor="#FFFFFF"
      android:textSize="12sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/pe_w_convert"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/pe_widget_btn"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:contentDescription="To PDF"
      android:src="@drawable/pe_ic_convert_w" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="To PDF"
      android:textColor="#FFFFFF"
      android:textSize="12sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>
</LinearLayout>
