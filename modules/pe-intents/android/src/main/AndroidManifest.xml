<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- home-screen widget: Scan, Open, Sign, Convert -->
    <receiver
      android:name="com.rezahossaini.peintents.PeWidget"
      android:exported="true"
      android:label="@string/pe_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/pe_widget_info" />
    </receiver>
  </application>
</manifest>
